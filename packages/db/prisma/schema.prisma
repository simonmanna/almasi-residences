// packages/db/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

// Prisma 7 removed `url` from the datasource block: the connection is supplied
// by a driver adapter at runtime (src/index.ts) and by prisma.config.ts for the
// CLI. See docs/DECISIONS.md D-02.
datasource db {
  provider   = "postgresql"
  // The postgis/postgis image installs all four of these at database creation.
  // Declaring only `postgis` makes every `migrate dev` report drift against the
  // three it did not know about, so they are all declared here.
  extensions = [postgis, postgis_topology, postgis_tiger_geocoder, fuzzystrmatch]
}

// ─────────────────────────── Development (the property) ────────────

/// The property. The admin's "Property Overview" edits this row; every public
/// page reads it. Counts (residences, availability, value) are never stored
/// here — they are derived from Unit rows at query time (D-33).
model Development {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  tagline       String?
  descriptionMd String            @db.Text
  city          String
  country       String
  addressLine   String?
  latitude      Float
  longitude     Float
  handoverDate  DateTime?
  currency      String            @default("USD")
  /// Legacy, unused: the residence count is derived. Kept so old rows load.
  totalUnits    Int               @default(0)
  status        DevelopmentStatus @default(SELLING)

  propertyType        String             @default("Residential apartments")
  /// "B + G + 4" — how the developer describes the stack.
  buildingConfig      String?
  constructionStatus  ConstructionStatus @default(STRUCTURE)
  constructionPercent Int?
  developerName       String?
  architect           String?
  contractor          String?
  yearStarted         Int?

  logoMediaId  String?
  logoMedia    Media?  @relation("DevelopmentLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  heroMediaId  String?
  heroMedia    Media?  @relation("DevelopmentHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  mainMediaId  String?
  mainMedia    Media?  @relation("DevelopmentMain", fields: [mainMediaId], references: [id], onDelete: SetNull)
  videoMediaId String?
  videoMedia   Media?  @relation("DevelopmentVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)

  // Contact — one place, read by the footer, the enquiry panel and WhatsApp links.
  contactPhone        String?
  contactEmail        String?
  whatsappNumber      String?
  /// Shows the small site-wide WhatsApp launcher when a number is configured.
  whatsappIconVisible Boolean @default(true)
  officeAddress       String?
  /// Google Maps link for the office address — the footer and contact blocks link to it.
  mapsUrl             String?
  officeHours         String?
  /// { instagram, facebook, linkedin, youtube, x, tiktok } — URLs.
  socials             Json?

  buildings       Building[]
  typologies      Typology[]
  amenities       Amenity[]
  milestones      PaymentMilestone[]
  paymentPlans    PaymentPlan[]
  landmarks       Landmark[]
  mediaSets       MediaSet[]
  tours           Tour[]
  progress        ProgressUpdate[]
  faqs            Faq[]
  seo             SeoMeta?
  units           Unit[]
  features        Feature[]
  parkingSpaces   ParkingSpace[]
  residents       Resident[]
  buyers          Buyer[]
  media           Media[]            @relation("DevelopmentMedia")
  galleries       Gallery[]
  pages           ContentPage[]
  mediaSlots      MediaSlot[]
  specifications  Specification[]
  seoPages        SeoPage[]
  seoEntities     SeoEntity[]
  redirects       Redirect[]
  locationPages   LocationPage[]
  posts           Post[]
  videos          VideoAsset[]
  enquiries       Enquiry[]
  viewings        Viewing[]
  reservations    Reservation[]
  notifications   Notification[]
  analyticsEvents AnalyticsEvent[]
  pipelineStages  PipelineStage[]
  leadTasks       LeadTask[]
  deals           Deal[]
  campaigns       Campaign[]
  leadDocuments   LeadDocument[]
  crmSettings     CrmSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DevelopmentStatus {
  ANNOUNCED
  SELLING
  SOLD_OUT
  COMPLETED
}

enum ConstructionStatus {
  PLANNING
  SITE_PREPARATION
  FOUNDATION
  STRUCTURE
  ENVELOPE
  FINISHES
  HANDOVER
  COMPLETED
}

// ─────────────────────────── Building / Floors / Residences ────────

model Building {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name          String
  floorCount    Int
  groundLabel   String      @default("Ground")
  // GLB for the 3D selector — see §8.4
  modelUrl      String?
  modelScale    Float       @default(1)
  floors        Floor[]

  @@index([developmentId])
}

model Floor {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  level       Int // 0 = ground, -1 = basement
  label       String // "Floor 1", "Penthouse"
  displayName String? // "Penthouse level" — what visitors read, when it differs
  description String?  @db.Text
  heightM     Float // cumulative height above ground, for the view simulator
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  // A floor holding residences cannot be deleted: they must be moved first (D-34).
  units       Unit[]
  media       Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@unique([buildingId, level])
  @@index([buildingId])
}

/// A residence. "Unit" is the historical table name; the admin calls it a residence.
model Unit {
  id            String      @id @default(cuid())
  /// Denormalised from floor → building so the unit code can be unique per property.
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  floorId       String
  // Restrict: deleting a floor never silently deletes the homes on it.
  floor         Floor       @relation(fields: [floorId], references: [id], onDelete: Restrict)
  typologyId    String
  typology      Typology    @relation(fields: [typologyId], references: [id], onDelete: Restrict)

  code                String // "A1", "PH-A"
  status              UnitStatus @default(AVAILABLE)
  priceMinor          Int // store money in minor units, never Float
  currency            String     @default("USD")
  /// Optional list-price reduction, minor units. Public price = price − discount.
  discountMinor       Int?
  /// A time-boxed promotional price, shown instead of the list price when set.
  promoPriceMinor     Int?
  promoEndsAt         DateTime?
  reservationFeeMinor Int?
  depositPercent      Float?

  bedrooms         Int
  bathrooms        Float
  areaSqm          Float // total saleable size
  interiorSqm      Float?
  exteriorSqm      Float?
  balconySqm       Float?
  terraceSqm       Float?
  parkingIncluded  Int         @default(0)
  hasStorage       Boolean     @default(false)
  storageNote      String?
  orientation      Orientation
  viewTags         String[] // ["hills", "city"]
  availabilityDate DateTime?

  shortDescription String?
  description      String? @db.Text

  positionIndex Int // left-to-right order on the elevation stack
  widthRatio    Float   @default(1) // relative width in the stack drawing
  // maps this unit to a mesh name inside the building GLB
  meshName      String?
  /// Which volume of the 3D maquette this residence occupies ("A", "PH-B").
  /// Null derives it from the code; an unresolvable value is a visible admin
  /// warning, never a silent disappearance (§40.1).
  modelSlot     String?

  paymentPlanId String?
  paymentPlan   PaymentPlan? @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  buyerId       String?
  buyer         Buyer?       @relation("UnitBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  published  Boolean   @default(true)
  featured   Boolean   @default(false)
  archivedAt DateTime?
  tags       String[]  @default([])
  /// PRIVATE — never selected by a public endpoint.
  notes      String?   @db.Text

  enquiries     EnquiryUnit[]
  statusLog     UnitStatusLog[]
  priceHistory  PriceHistory[]
  rooms         Room[]
  features      UnitFeature[]
  media         Media[]
  residents     Resident[]
  residencies   Residency[]
  parkingSpaces ParkingSpace[]
  interests     BuyerInterest[]
  viewings      ViewingUnit[]
  reservations  Reservation[]
  primaryLeads  Enquiry[]       @relation("LeadPrimaryUnit")
  deals         Deal[]
  leadTasks     LeadTask[]
  altViewings   Viewing[]       @relation("ViewingAlternative")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?

  @@unique([developmentId, code])
  @@unique([floorId, code])
  @@index([status])
  @@index([typologyId])
  @@index([floorId])
  @@index([published, archivedAt])
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
  UNAVAILABLE
}

enum Orientation {
  N
  NE
  E
  SE
  S
  SW
  W
  NW
}

model UnitStatusLog {
  id        String     @id @default(cuid())
  unitId    String
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  from      UnitStatus
  to        UnitStatus
  /// AdminUser id, or "system".
  actor     String
  note      String?
  createdAt DateTime   @default(now())

  @@index([unitId])
  @@index([createdAt])
}

model PriceHistory {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fromMinor Int
  toMinor   Int
  currency  String
  actor     String
  reason    String?
  createdAt DateTime @default(now())

  @@index([unitId, createdAt])
}

/// A space inside a residence: living room, bedroom 1, balcony…
model Room {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  type        RoomType
  areaSqm     Float?
  description String?  @db.Text
  features    String[] @default([])
  /// Position on the residence plan, in plan coordinates.
  planX       Float?
  planY       Float?
  /// Width and depth on the residence plan, in the same units as planX/planY.
  planW       Float?
  planH       Float?
  /// A balcony or terrace: drawn hatched, as outside space.
  planOpen    Boolean  @default(false)
  sortOrder   Int      @default(0)
  media       Media[]

  @@index([unitId])
}

enum RoomType {
  LIVING
  DINING
  KITCHEN
  BEDROOM
  BATHROOM
  WC
  STUDY
  BALCONY
  TERRACE
  STORAGE
  LAUNDRY
  HALL
  OTHER
}

/// The feature catalogue — "Fitted kitchen", "Walk-in wardrobe"… — assigned per residence.
model Feature {
  id            String        @id @default(cuid())
  developmentId String
  development   Development   @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name          String
  category      String        @default("General")
  iconKey       String?
  sortOrder     Int           @default(0)
  units         UnitFeature[]

  @@unique([developmentId, name])
}

model UnitFeature {
  unitId    String
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  note      String?

  @@id([unitId, featureId])
  @@index([featureId])
}

// ─────────────────────────── Residence types ────────────────────────

/// A residence type ("One bedroom", "Three bedroom penthouse"). Editable in the
/// admin — the public site groups by `isPenthouse` and bedroom count, never by
/// a list in code.
model Typology {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  slug          String
  name          String // "Two-bedroom corner"
  bedrooms      Int
  bathrooms     Float // 2.5 is legal
  areaSqmMin    Float
  areaSqmMax    Float
  descriptionMd String?     @db.Text
  /// One line for the homepage card: what living in this type is like.
  summary       String?
  isPenthouse   Boolean     @default(false)
  sortOrder     Int         @default(0)
  published     Boolean     @default(true)

  floorPlanSvgUrl String? // interactive plan, see §8.3
  floorPlanPngUrl String?
  glbUrl          String? // per-unit 3D model, F12
  frameSeqId      String? // interactive video frame sequence

  units          Unit[]
  tours          Tour[]
  mediaSets      MediaSet[]
  media          Media[]
  specifications Specification[]
  leads          Enquiry[]

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@unique([developmentId, slug])
}

// ─────────────────────────── Media library ──────────────────────────

/// Every uploaded file the admin manages: photos, renders, videos, floor plans,
/// architectural drawings. One table, attached to at most one owner (unit,
/// floor, amenity, room, typology) — or to none, which means "the project".
model Media {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation("DevelopmentMedia", fields: [developmentId], references: [id], onDelete: Cascade)

  kind       MediaKind
  collection MediaCollection @default(LIBRARY)
  /// Validated against the lists in @avida/types (IMAGE_CATEGORIES, DESIGN_CATEGORIES…).
  category   String          @default("OTHER")

  title   String?
  caption String?
  altText String?

  storageKey  String  @unique
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Float?
  /// { "400": key, "800": key, "1600": key } — web-friendly WebP renditions.
  variants    Json?
  posterKey   String?
  blurDataUrl String? @db.Text
  dominantHex String?

  published  Boolean         @default(true)
  isCover    Boolean         @default(false)
  sortOrder  Int             @default(0)
  /// §49 — what this file is. A CG render must never read as a photograph.
  provenance MediaProvenance @default(PHOTOGRAPH)
  /// Focal point, 0–100 on each axis: what a cover crop keeps in frame.
  focusX     Float?
  focusY     Float?

  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  floorId    String?
  floor      Floor?    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  amenityId  String?
  amenity    Amenity?  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  typologyId String?
  typology   Typology? @relation(fields: [typologyId], references: [id], onDelete: Cascade)

  uploadedById String?

  galleryItems  GalleryItem[]
  galleryCovers Gallery[]     @relation("GalleryCover")
  residents     Resident[]
  logoFor       Development[] @relation("DevelopmentLogo")
  heroFor       Development[] @relation("DevelopmentHero")
  mainFor       Development[] @relation("DevelopmentMain")
  videoFor      Development[] @relation("DevelopmentVideo")
  slotImages    MediaSlot[]   @relation("SlotImage")
  slotVideos    MediaSlot[]   @relation("SlotVideo")
  sceneImages   Scene[]       @relation("SceneImage")
  sceneVideos   Scene[]       @relation("SceneVideo")
  filmVideos    VideoAsset[]  @relation("FilmVideo")
  filmPosters   VideoAsset[]  @relation("FilmPoster")
  seoImages     SeoPage[]     @relation("SeoImage")
  seoEntityImages SeoEntity[]   @relation("SeoEntityImage")
  locationHeroes  LocationPage[] @relation("LocationHero")
  postHeroes      Post[]         @relation("PostHero")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@index([developmentId, collection, kind])
  @@index([unitId])
  @@index([floorId])
  @@index([amenityId])
  @@index([roomId])
  @@index([typologyId])
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  MODEL
}

enum MediaProvenance {
  PHOTOGRAPH
  SUPPLIED_RENDER
  CONCEPT_RENDER
  DRAWING
}

/// §52 — a named place on the public site that shows media: the homepage hero,
/// the film teaser, a page header. The site asks for a slot by key; the admin
/// decides which library file fills it. An empty slot renders a neutral frame,
/// never a substitute image.
model MediaSlot {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  key           String
  imageId       String?
  image         Media?      @relation("SlotImage", fields: [imageId], references: [id], onDelete: SetNull)
  videoId       String?
  video         Media?      @relation("SlotVideo", fields: [videoId], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@unique([developmentId, key])
}

enum MediaCollection {
  LIBRARY
  FLOOR_PLAN
  DESIGN
}

model Gallery {
  id            String        @id @default(cuid())
  developmentId String
  development   Development   @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  description   String?       @db.Text
  coverMediaId  String?
  coverMedia    Media?        @relation("GalleryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  sortOrder     Int           @default(0)
  published     Boolean       @default(true)
  items         GalleryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@unique([developmentId, slug])
}

model GalleryItem {
  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@id([galleryId, mediaId])
  @@index([mediaId])
}

// ─────────────────────────── Media (time-state system) ─────────────

/// A MediaSet groups the SAME view captured across time states.
/// This is the backbone of the day/night/aerial system (F7).
model MediaSet {
  id            String       @id @default(cuid())
  developmentId String?
  development   Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  typologyId    String?
  typology      Typology?    @relation(fields: [typologyId], references: [id], onDelete: Cascade)

  key        String // "hero-exterior", "rooftop", "lobby"
  label      String
  kind       MediaSetKind
  cameraNote String? // for the render team: focal length, position
  sortOrder  Int          @default(0)

  assets MediaAsset[]

  @@unique([developmentId, key])
  @@index([typologyId])
}

enum MediaSetKind {
  EXTERIOR
  INTERIOR
  AERIAL
  AMENITY
  CONTEXT
  PLAN
}

model MediaAsset {
  id         String   @id @default(cuid())
  mediaSetId String
  mediaSet   MediaSet @relation(fields: [mediaSetId], references: [id], onDelete: Cascade)

  timeState TimeState
  role      AssetRole @default(PRIMARY)

  // originals + derivatives, all keys relative to R2 bucket root
  originalKey String
  width       Int
  height      Int
  variants    Json // { avif: {400:key,...}, webp: {...} }
  depthKey    String? // depth map PNG for parallax (F8)
  thumbhash   String
  dominantHex String?

  altText String?
  credit  String?

  createdAt DateTime @default(now())

  @@unique([mediaSetId, timeState, role])
  @@index([mediaSetId])
}

enum TimeState {
  DAWN
  DAY
  DUSK
  NIGHT
}

enum AssetRole {
  PRIMARY
  ALTERNATE
  DETAIL
}

// ─────────────────────────── Video ──────────────────────────────────

model VideoAsset {
  id            String       @id @default(cuid())
  key           String       @unique // "walkthrough-2bed", "timelapse-hero"
  label         String
  kind          VideoKind
  typologyId    String?
  developmentId String?
  development   Development? @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  description   String?      @db.Text
  /// The film itself, from the media library (§5.7). The keys below are the
  /// encode pipeline's outputs, kept for the HLS path.
  mediaId       String?
  media         Media?       @relation("FilmVideo", fields: [mediaId], references: [id], onDelete: SetNull)
  posterMediaId String?
  posterMedia   Media?       @relation("FilmPoster", fields: [posterMediaId], references: [id], onDelete: SetNull)
  published     Boolean      @default(true)

  posterKey   String
  hlsKey      String? // .m3u8 master
  mp4Key      String? // fallback, h.264 720p
  durationSec Float
  width       Int
  height      Int

  chapters VideoChapter[]

  /// §SEO — what a VideoObject needs beyond the file: spoken words for search
  /// engines, and the caption track a viewer reads.
  transcript  String? @db.Text
  captionsKey String?
  uploadDate  DateTime?

  createdAt DateTime @default(now())
}

enum VideoKind {
  WALKTHROUGH
  TIMELAPSE
  AERIAL
  AMBIENT
}

model VideoChapter {
  id            String     @id @default(cuid())
  videoAssetId  String
  videoAsset    VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  label         String
  startSec      Float
  thumbKey      String?
  /// Where in the building the film is at this point.
  place         String?
  sortOrder     Int        @default(0)
  /// optional: jump into the panorama tour at this point
  linkedSceneId String?

  @@index([videoAssetId])
}

/// Scroll-driven interactive video (F11, F12). Stored as a frame ladder,
/// not a video file — see §8.5 for why.
model FrameSequence {
  id         String       @id @default(cuid())
  key        String       @unique // "building-orbit", "typo-2bed-orbit"
  label      String
  kind       FrameSeqKind
  frameCount Int
  // Multiple resolution ladders: { "480": {prefix, ext}, "960": {...} }
  ladders    Json
  loopable   Boolean      @default(true)
  /// maps a frame index range to a unit / hotspot for click targeting
  hotspots   Json?

  createdAt DateTime @default(now())
}

enum FrameSeqKind {
  ORBIT
  DOLLY
  TIMELAPSE
  ASSEMBLY
}

// ─────────────────────────── Virtual tour ───────────────────────────

model Tour {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  typologyId    String?
  typology      Typology?   @relation(fields: [typologyId], references: [id])

  slug         String
  name         String
  description  String?  @db.Text
  startSceneId String?
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  scenes       Scene[]
  updatedAt    DateTime @default(now()) @updatedAt

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@unique([developmentId, slug])
}

model Scene {
  id        String  @id @default(cuid())
  tourId    String
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  key       String // "living", "kitchen", "master-bed"
  label     String
  sortOrder Int     @default(0)
  /// The walkthrough station's words: where it is, and what to notice.
  place     String?
  body      String? @db.Text
  /// The homepage story gauge: where in the building this station is (TOUR_LEVELS).
  level     String?
  imageId   String?
  image     Media?  @relation("SceneImage", fields: [imageId], references: [id], onDelete: SetNull)
  videoId   String?
  video     Media?  @relation("SceneVideo", fields: [videoId], references: [id], onDelete: SetNull)
  published Boolean @default(true)

  /// Panoramas per time state — the tour respects the global time selector
  panoramas PanoramaAsset[]

  /// initial camera
  yawDeg   Float @default(0)
  pitchDeg Float @default(0)
  fovDeg   Float @default(70)

  /// position on the floor plan SVG, in plan viewBox coordinates
  planX      Float?
  planY      Float?
  planRotDeg Float?

  hotspots  Hotspot[]
  linksFrom Hotspot[] @relation("HotspotTarget")

  @@unique([tourId, key])
}

model PanoramaAsset {
  id          String    @id @default(cuid())
  sceneId     String
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  timeState   TimeState
  /// low-res immediate preview, equirect 1024x512
  previewKey  String
  /// full equirect original
  originalKey String
  /// cube-face tile manifest: { faceSize, levels:[{size,tileSize,prefix}] }
  tiles       Json
  width       Int
  height      Int

  @@unique([sceneId, timeState])
}

model Hotspot {
  id            String      @id @default(cuid())
  sceneId       String
  scene         Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  kind          HotspotKind
  yawDeg        Float
  pitchDeg      Float
  label         String?
  targetSceneId String?
  targetScene   Scene?      @relation("HotspotTarget", fields: [targetSceneId], references: [id])
  infoMd        String?     @db.Text
  mediaAssetId  String?

  @@index([sceneId])
}

enum HotspotKind {
  NAVIGATE
  INFO
  MEASURE
  VIEW_OUT
}

// ─────────────────────────── Commercial ─────────────────────────────

/// A named payment plan. The default plan's milestones are what the public
/// payment timeline shows; a residence may be put on a different plan.
model PaymentPlan {
  id                  String             @id @default(cuid())
  developmentId       String
  development         Development        @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name                String
  description         String?            @db.Text
  isDefault           Boolean            @default(false)
  published           Boolean            @default(true)
  depositPercent      Float?
  reservationFeeMinor Int?
  installmentCount    Int?
  durationMonths      Int?
  sortOrder           Int                @default(0)
  milestones          PaymentMilestone[]
  units               Unit[]
  deals               Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@index([developmentId])
}

model PaymentMilestone {
  id            String           @id @default(cuid())
  developmentId String
  development   Development      @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  paymentPlanId String?
  paymentPlan   PaymentPlan?     @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  sortOrder     Int
  label         String // "On reservation", "On completion of structure"
  percent       Float // 10 = 10%
  triggerType   MilestoneTrigger
  triggerDate   DateTime?
  triggerNote   String?

  @@index([developmentId])
  @@index([paymentPlanId])
}

enum MilestoneTrigger {
  ON_RESERVATION
  ON_SIGNING
  ON_DATE
  ON_CONSTRUCTION_STAGE
  ON_HANDOVER
}

model Amenity {
  id               String      @id @default(cuid())
  developmentId    String
  development      Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name             String
  /// Stable handle the public site uses to pair an amenity with its scene art.
  slug             String?
  descriptionMd    String?
  shortDescription String?
  iconKey          String?
  mediaAssetId     String?
  /// [{ label, value }] — "Length: 15 m", "Hours: 06:00–22:00".
  specifications   Json?
  location         String?
  published        Boolean     @default(true)
  sortOrder        Int         @default(0)
  media            Media[]

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@index([developmentId])
}

model Landmark {
  id             String           @id @default(cuid())
  developmentId  String
  development    Development      @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name           String
  category       LandmarkCategory
  latitude       Float
  longitude      Float
  /// computed by PostGIS at seed/update time, not hardcoded — unless manualDistance
  distanceM      Int?
  driveMinutes   Int?
  walkMinutes    Int?
  /// true when the admin typed the distance and times rather than having them computed
  manualDistance Boolean          @default(false)
  /// when false, the landmark is hidden from the public site but kept in the admin
  visible        Boolean          @default(true)

  @@index([developmentId])
}

enum LandmarkCategory {
  SCHOOL
  EMBASSY
  HOSPITAL
  SHOPPING
  AIRPORT
  LEISURE
  BUSINESS
}

// ─────────────────────────── Parking ────────────────────────────────

model ParkingSpace {
  id            String        @id @default(cuid())
  developmentId String
  development   Development   @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  code          String // "P-01"
  level         String        @default("Basement")
  type          ParkingType   @default(STANDARD)
  sizeSqm       Float?
  status        ParkingStatus @default(AVAILABLE)
  unitId        String?
  unit          Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  residentId    String?
  resident      Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  priceMinor    Int?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([developmentId, code])
  @@index([status])
  @@index([unitId])
}

enum ParkingType {
  STANDARD
  COMPACT
  ACCESSIBLE
  EV
  VISITOR
  MOTORCYCLE
}

enum ParkingStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  SOLD
  UNAVAILABLE
}

// ─────────────────────────── People (PRIVATE) ───────────────────────

/// Someone living in a residence. PRIVATE: never reachable from a public endpoint.
model Resident {
  id              String          @id @default(cuid())
  developmentId   String
  development     Development     @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  fullName        String
  email           String?
  phone           String?
  countryIso      String?
  unitId          String?
  unit            Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  residentType    ResidentType    @default(OWNER)
  occupancyStatus OccupancyStatus @default(UPCOMING)
  moveInDate      DateTime?
  moveOutDate     DateTime?
  notes           String?         @db.Text
  profileMediaId  String?
  profileMedia    Media?          @relation(fields: [profileMediaId], references: [id], onDelete: SetNull)
  buyerId         String?
  buyer           Buyer?          @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  archivedAt      DateTime?

  residencies   Residency[]
  parkingSpaces ParkingSpace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([developmentId, archivedAt])
}

enum ResidentType {
  OWNER
  TENANT
  FAMILY
  OTHER
}

enum OccupancyStatus {
  UPCOMING
  ACTIVE
  MOVED_OUT
}

/// Residence history — one row per stay.
model Residency {
  id         String    @id @default(cuid())
  residentId String
  resident   Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  actor      String

  @@index([residentId])
  @@index([unitId])
}

/// A client — prospect through owner. PRIVATE.
model Buyer {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  fullName      String
  email         String?
  phone         String?
  countryIso    String?
  stage         BuyerStage  @default(PROSPECT)
  source        String?
  assignedToId  String?
  assignedTo    AdminUser?  @relation("BuyerAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes         String?     @db.Text
  archivedAt    DateTime?

  units        Unit[]          @relation("UnitBuyer")
  interests    BuyerInterest[]
  enquiries    Enquiry[]
  residents    Resident[]
  viewings     Viewing[]
  reservations Reservation[]
  deals        Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([developmentId, archivedAt])
}

enum BuyerStage {
  PROSPECT
  ENQUIRY
  INTERESTED
  RESERVATION
  BUYER
  OWNER
  RESIDENT
}

model BuyerInterest {
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([buyerId, unitId])
  @@index([unitId])
}

// ─────────────────────────── Leads ──────────────────────────────────

model Enquiry {
  id               String         @id @default(cuid())
  /// §40.5 — every lead belongs to a property. Backfilled from its residences.
  developmentId    String
  development      Development    @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name             String
  /// A walk-in or a phone call may leave only one way to reach them; the API
  /// requires at least a phone or an email.
  email            String?
  phone            String?
  whatsapp         String?
  countryIso       String?
  city             String?
  preferredContact ContactMethod?
  message          String?        @db.Text
  intent           EnquiryIntent  @default(INFORMATION)

  units EnquiryUnit[]

  source      String? // "unit-panel", "footer", "floating-cta"
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  landingPath String?
  userAgent   String?

  status         EnquiryStatus    @default(NEW)
  /// The configurable pipeline column. `status` is kept equal to the stage's
  /// category, so automation and reports never depend on a label an admin renamed.
  stageId        String?
  stage          PipelineStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stageChangedAt DateTime         @default(now())
  /// Where the lead came from, as the sales team counts it (`source` is the website placement).
  leadSource     LeadSource       @default(WEBSITE)
  campaignId     String?
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Manual override; null means "derived from the score".
  temperature    LeadTemperature?
  /// Cached transparent score (0-100), recomputed on every write. The breakdown is computed on read.
  score          Int              @default(0)
  priority       CrmPriority      @default(NORMAL)

  typologyId        String?
  typology          Typology?         @relation(fields: [typologyId], references: [id], onDelete: SetNull)
  primaryUnitId     String?
  primaryUnit       Unit?             @relation("LeadPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: SetNull)
  bedrooms          Int?
  sizeMinSqm        Float?
  sizeMaxSqm        Float?
  budgetMinMinor    Int?
  budgetMaxMinor    Int?
  floorPreference   String?
  purpose           LeadPurpose?
  financingRequired Boolean?
  budgetConfirmed   Boolean           @default(false)
  timeline          PurchaseTimeline?
  decisionMaker     String?
  tags              String[]          @default([])

  lastContactAt      DateTime?
  createdById        String?
  createdBy          AdminUser?          @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Soft delete. An archived lead is hidden from every list but keeps its history.
  archivedAt         DateTime?
  tasks              LeadTask[]
  deals              Deal[]
  documents          LeadDocument[]
  stageChanges       LeadStageChange[]
  adminNotifications AdminNotification[]

  /// §40.3 — the agent working the lead (a real foreign key, audit §15.5).
  assignedToId   String?
  assignedTo     AdminUser?     @relation("EnquiryAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Legacy single note, kept read-only; the history lives in LeadNote.
  internalNote   String?        @db.Text
  /// §15.3 — when the sales team first answered, and when they must next act.
  contactedAt    DateTime?
  followUpAt     DateTime?
  lastActivityAt DateTime?
  lostReason     LostReason?
  lostNote       String?
  /// Set when the same person asked again within the dedup window (§15.6).
  duplicateOfId  String?
  repeatCount    Int            @default(0)
  notes          LeadNote[]
  viewings       Viewing[]
  reservations   Reservation[]
  notifications  Notification[]
  buyerId        String?
  buyer          Buyer?         @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  // §5.9 — PII retention. Set to createdAt + 24 months on write, moved forward
  // on any status change. The nightly job hard-deletes rows past this date.
  purgeAfter DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([purgeAfter])
  @@index([buyerId])
  @@index([developmentId, createdAt])
  @@index([assignedToId])
  @@index([followUpAt])
  @@index([email])
  @@index([phone])
  @@index([developmentId, stageId])
  @@index([developmentId, archivedAt])
}

enum EnquiryIntent {
  INFORMATION
  VIEWING
  RESERVATION
  BROKER
}

/// §40.3 — the sales pipeline.
enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPERTY_INTEREST
  VIEWING_SCHEDULED
  /// Viewing completed.
  VIEWED
  NEGOTIATION
  RESERVED
  CONTRACT
  SOLD
  ON_HOLD
  LOST
  DISQUALIFIED
  SPAM
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  GOOGLE
  PROPERTY_PORTAL
  REFERRAL
  WALK_IN
  PHONE
  EMAIL
  CAMPAIGN
  AGENT
  OTHER
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum ContactMethod {
  PHONE
  WHATSAPP
  EMAIL
  SMS
}

enum LeadPurpose {
  OWN_USE
  INVESTMENT
  OTHER
}

enum PurchaseTimeline {
  IMMEDIATE
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_12_MONTHS
  OVER_12_MONTHS
  UNDECIDED
}

enum CrmPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LostReason {
  PRICE
  LOCATION
  TIMING
  CHOSE_COMPETITOR
  FINANCING
  NO_RESPONSE
  OTHER
}

/// §15.4 — one entry per touch: a note, a call, a message. Never overwritten.
model LeadNote {
  id          String       @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry      @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId    String?
  author      AdminUser?   @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind        LeadNoteKind @default(NOTE)
  body        String       @db.Text
  /// "IN" (the customer reached us) or "OUT". Null for notes and system events.
  direction   String?
  durationMin Int?
  /// Structured detail for system events: { unitId, dealId, taskId, viewingId, from, to }.
  meta        Json?
  pinned      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([enquiryId, createdAt])
  @@index([kind, createdAt])
}

enum LeadNoteKind {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  SMS
  MEETING
  VIEWING
  DOCUMENT
  TASK
  ASSIGNMENT
  RESERVATION
  DEAL
  STATUS
  SYSTEM
}

/// Every pipeline move, so reports can say how long a lead sat in each stage.
model LeadStageChange {
  id          String         @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStageId String?
  toStageId   String?
  fromStatus  EnquiryStatus?
  toStatus    EnquiryStatus
  actorId     String?
  createdAt   DateTime       @default(now())

  @@index([enquiryId, createdAt])
  @@index([createdAt])
}

/// The admin-configurable pipeline. Each column maps to a system category.
model PipelineStage {
  id            String        @id @default(cuid())
  developmentId String
  development   Development   @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  label         String
  category      EnquiryStatus
  /// A tone name from the admin palette: sky, blue, teal, purple, orange, indigo, green, grey, red.
  color         String        @default("sky")
  position      Int
  /// Win probability used for the weighted pipeline value.
  probability   Int           @default(0)
  active        Boolean       @default(true)
  leads         Enquiry[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([developmentId, position])
}

/// A follow-up, a call to make, a document to send. A lead's "next action" is its earliest open task.
model LeadTask {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  enquiryId     String?
  enquiry       Enquiry?    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  dealId        String?
  deal          Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  title         String
  type          TaskType    @default(FOLLOW_UP)
  priority      CrmPriority @default(NORMAL)
  dueAt         DateTime?
  /// True when only the day matters, not the time.
  allDay        Boolean     @default(false)
  remindAt      DateTime?
  status        TaskStatus  @default(OPEN)
  assignedToId  String?
  assignedTo    AdminUser?  @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     AdminUser?  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  completedById String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([developmentId, status, dueAt])
  @@index([assignedToId, status])
  @@index([enquiryId, status])
}

enum TaskType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  MEETING
  FOLLOW_UP
  SEND_BROCHURE
  SEND_FLOOR_PLAN
  SEND_QUOTATION
  SEND_PAYMENT_PLAN
  SCHEDULE_VIEWING
  POST_VIEWING
  PAYMENT
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// A negotiation on one residence for one lead: the price, the terms, and the
/// reservation and sale it becomes. Unit status only changes through the deal's
/// reservation, so the inventory rules live in one place.
model Deal {
  id                     String         @id @default(cuid())
  developmentId          String
  development            Development    @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  enquiryId              String?
  enquiry                Enquiry?       @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  buyerId                String?
  buyer                  Buyer?         @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  unitId                 String
  unit                   Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  agentId                String?
  agent                  AdminUser?     @relation("DealAgent", fields: [agentId], references: [id], onDelete: SetNull)
  status                 DealStatus     @default(NEGOTIATION)
  listPriceMinor         Int
  agreedPriceMinor       Int?
  discountMinor          Int?
  currency               String         @default("USD")
  reservationAmountMinor Int?
  paymentPlanId          String?
  paymentPlan            PaymentPlan?   @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  expectedCloseAt        DateTime?
  contractSignedAt       DateTime?
  closedAt               DateTime?
  lostReason             LostReason?
  lostNote               String?
  notes                  String?        @db.Text
  reservationId          String?        @unique
  reservation            Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdById            String?
  createdBy              AdminUser?     @relation("DealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt             DateTime?
  tasks                  LeadTask[]
  documents              LeadDocument[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([developmentId, status])
  @@index([unitId, status])
  @@index([enquiryId])
}

enum DealStatus {
  NEGOTIATION
  RESERVED
  CONTRACT
  SOLD
  LOST
  CANCELLED
}

model Campaign {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name          String
  channel       LeadSource  @default(CAMPAIGN)
  /// Website leads whose utm_campaign equals this are linked automatically.
  utmCampaign   String?
  startsAt      DateTime?
  endsAt        DateTime?
  budgetMinor   Int?
  active        Boolean     @default(true)
  notes         String?     @db.Text
  leads         Enquiry[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([developmentId, name])
  @@index([developmentId, utmCampaign])
}

/// A file on a lead or deal: a quotation sent, a signed agreement, an ID copy.
model LeadDocument {
  id            String       @id @default(cuid())
  developmentId String
  development   Development  @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  enquiryId     String?
  enquiry       Enquiry?     @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  dealId        String?
  deal          Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  kind          DocumentKind @default(OTHER)
  name          String
  storageKey    String?
  url           String?
  mimeType      String?
  sizeBytes     Int?
  sentAt        DateTime?
  uploadedById  String?
  uploadedBy    AdminUser?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([enquiryId])
  @@index([dealId])
}

enum DocumentKind {
  BROCHURE
  FLOOR_PLAN
  PAYMENT_PLAN
  QUOTATION
  AGREEMENT
  ID_DOCUMENT
  RECEIPT
  OTHER
}

/// In-app notifications for one admin user (the bell). Email delivery is `Notification`.
model AdminNotification {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  link      String?
  enquiryId String?
  enquiry   Enquiry?  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  /// Makes generation idempotent ("task-overdue:<taskId>").
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model SavedView {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  name      String
  filters   Json
  shared    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([scope, userId])
}

model CrmSettings {
  id               String         @id @default(cuid())
  developmentId    String         @unique
  development      Development    @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  assignmentMode   AssignmentMode @default(MANUAL)
  /// The agents new website leads rotate between (AdminUser ids).
  assignmentPool   String[]       @default([])
  roundRobinCursor Int            @default(0)
  /// [{ key, points, enabled }] — overrides the defaults in @avida/types.
  scoringRules     Json?
  hotThreshold     Int            @default(70)
  warmThreshold    Int            @default(40)
  updatedAt        DateTime       @updatedAt
}

enum AssignmentMode {
  MANUAL
  ROUND_ROBIN
  LEAST_LOADED
}

/// §15.2 — a viewing is booked, not implied by an enquiry's intent.
model Viewing {
  id                 String           @id @default(cuid())
  developmentId      String
  development        Development      @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  enquiryId          String?
  enquiry            Enquiry?         @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  buyerId            String?
  buyer              Buyer?           @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  /// Copied from the enquiry so a viewing survives the lead's retention purge window on its own terms.
  name               String
  email              String?
  phone              String?
  /// What the visitor asked for.
  requestedDate      DateTime?
  requestedSlot      String?
  /// What the sales team confirmed.
  scheduledAt        DateTime?
  durationMinutes    Int              @default(45)
  agentId            String?
  agent              AdminUser?       @relation("ViewingAgent", fields: [agentId], references: [id], onDelete: SetNull)
  status             ViewingStatus    @default(REQUESTED)
  location           String?
  notes              String?          @db.Text
  outcome            String?          @db.Text
  /// Post-viewing feedback.
  interestLevel      ViewingInterest?
  objections         String?          @db.Text
  alternativeUnitId  String?
  alternativeUnit    Unit?            @relation("ViewingAlternative", fields: [alternativeUnitId], references: [id], onDelete: SetNull)
  feedbackAt         DateTime?
  feedbackById       String?
  rescheduleCount    Int              @default(0)
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  units              ViewingUnit[]
  notifications      Notification[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([developmentId, scheduledAt])
  @@index([status])
  @@index([agentId])
}

enum ViewingStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum ViewingInterest {
  VERY_INTERESTED
  INTERESTED
  NEEDS_FOLLOW_UP
  NOT_INTERESTED
  WANTS_ANOTHER
}

model ViewingUnit {
  viewingId String
  viewing   Viewing @relation(fields: [viewingId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([viewingId, unitId])
  @@index([unitId])
}

/// §40.3 / audit §12 — a hold on a residence, with an expiry and a deposit.
model Reservation {
  id                 String            @id @default(cuid())
  developmentId      String
  development        Development       @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  unitId             String
  unit               Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  buyerId            String?
  buyer              Buyer?            @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  enquiryId          String?
  enquiry            Enquiry?          @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  agentId            String?
  agent              AdminUser?        @relation("ReservationAgent", fields: [agentId], references: [id], onDelete: SetNull)
  status             ReservationStatus @default(ACTIVE)
  heldUntil          DateTime
  depositMinor       Int?
  currency           String            @default("USD")
  depositReceivedAt  DateTime?
  /// The unit status before the hold, restored when it lapses.
  previousStatus     UnitStatus        @default(AVAILABLE)
  notes              String?           @db.Text
  closedAt           DateTime?
  closedReason       String?
  expiryNoticeSentAt DateTime?
  deal               Deal?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([developmentId, status])
  @@index([unitId, status])
  /// At most one live hold per residence, whatever path creates it.
  @@unique([unitId], map: "Reservation_one_active_per_unit", where: raw("status = 'ACTIVE'"))
  @@index([heldUntil])
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELLED
}

/// §15.1 — every email the platform owes someone, delivered by the worker with
/// retries. A row that cannot be delivered is visible, never silently lost.
model Notification {
  id            String             @id @default(cuid())
  developmentId String
  development   Development        @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  kind          NotificationKind
  recipient     String
  subject       String
  text          String             @db.Text
  replyTo       String?
  status        NotificationStatus @default(QUEUED)
  attempts      Int                @default(0)
  lastError     String?
  enquiryId     String?
  enquiry       Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  viewingId     String?
  viewing       Viewing?           @relation(fields: [viewingId], references: [id], onDelete: SetNull)
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([enquiryId])
}

enum NotificationKind {
  ENQUIRY_ALERT
  ENQUIRY_ACKNOWLEDGEMENT
  VIEWING_REQUESTED
  VIEWING_CONFIRMATION
  VIEWING_REMINDER
  LEADS_DIGEST
  RESERVATION_EXPIRING
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Roadmap item 40 — first-party, cookieless analytics. No IP, no personal data:
/// a random per-tab session id, the page, and what happened.
model AnalyticsEvent {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  name          String
  sessionId     String
  path          String?
  unitId        String?
  props         Json?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  device        String?
  createdAt     DateTime    @default(now())

  @@index([developmentId, name, createdAt])
  @@index([unitId, name])
  @@index([sessionId])
}

model EnquiryUnit {
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([enquiryId, unitId])
  @@index([unitId])
}

// ─────────────────────────── Content ────────────────────────────────

model ProgressUpdate {
  id              String      @id @default(cuid())
  developmentId   String
  development     Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  capturedOn      DateTime
  title           String
  bodyMd          String?     @db.Text
  percentComplete Int?
  mediaAssetIds   String[]
  splatUrl        String?
  published       Boolean     @default(true)

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@index([developmentId, capturedOn])
}

model Faq {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  question      String
  answerMd      String      @db.Text
  category      String      @default("General")
  published     Boolean     @default(true)
  sortOrder     Int         @default(0)

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?
}

/// Editable copy for one public page. `content` is a flat object whose keys are
/// declared in @avida/types (CONTENT_PAGES), so the admin renders the form and
/// the site knows every key it may read.
model ContentPage {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  key           String // "home" | "about" | "amenities" | "buying" | "gallery" | "contact"
  title         String
  content       Json
  published     Boolean     @default(true)
  updatedById   String?
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  /// §40.2 — edits are saved here first. Publishing copies them into `content`,
  /// which is all a visitor ever reads; a preview reads the draft.
  draftContent     Json?
  draftUpdatedAt   DateTime?
  draftUpdatedById String?
  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt      DateTime?
  publishedById    String?
  unpublishedAt    DateTime?

  @@unique([developmentId, key])
}

model SeoMeta {
  id            String      @id @default(cuid())
  developmentId String      @unique
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  title         String
  description   String
  ogImageKey    String?
  keywords      String[]

  /// §SEO — search-engine and analytics accounts. Empty means "not connected",
  /// and the website renders no tag at all rather than an empty one.
  gscVerification  String?
  bingVerification String?
  ga4MeasurementId String?
  gtmContainerId   String?
  /// Organization schema: the legal name and the profiles that confirm it.
  organizationName String?
  organizationType String  @default("Organization")
  sameAs           String[]
}

/// §5.6 — what search engines and link previews read for one public route.
/// `path` is the route ("/", "/amenities"). A missing field falls back to the
/// site-wide SeoMeta.
model SeoPage {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  path          String
  title         String?
  description   String?
  ogImageId     String?
  ogImage       Media?      @relation("SeoImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  noindex       Boolean     @default(false)
  updatedById   String?
  updatedAt     DateTime    @updatedAt

  @@unique([developmentId, path])
}

/// §5.4 — the specification a buyer reads ("Floors — tiled throughout"). A row
/// with a typology applies to that type only and replaces a development-wide
/// row with the same label.
model Specification {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  typologyId    String?
  typology      Typology?   @relation(fields: [typologyId], references: [id], onDelete: Cascade)
  category      String      @default("General")
  label         String
  value         String      @db.Text
  sortOrder     Int         @default(0)
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// §40.2 — who published it and when; set by the publish action, not by an edit.
  publishedAt   DateTime?
  publishedById String?
  unpublishedAt DateTime?
  /// Soft delete (§40.2): hidden everywhere, restorable until permanently deleted.
  archivedAt    DateTime?

  @@index([developmentId, typologyId])
}

/// §3.4 — one attempt to tell the website that something changed. A row that
/// cannot be delivered is retried with backoff and then shown on the dashboard:
/// a publish never silently fails to propagate.
model SyncEvent {
  id              String     @id @default(cuid())
  developmentSlug String
  scope           String
  tags            String[]
  status          SyncStatus @default(PENDING)
  attempts        Int        @default(0)
  lastError       String?
  nextAttemptAt   DateTime   @default(now())
  deliveredAt     DateTime?
  createdAt       DateTime   @default(now())

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

/// Phase 6 — a recoverable snapshot of published page copy.
model ContentRevision {
  id            String   @id @default(cuid())
  developmentId String
  pageKey       String
  content       Json
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([developmentId, pageKey, createdAt])
}

/// Phase 6 — publication work that the worker executes at the requested time.
model PublicationSchedule {
  id            String    @id @default(cuid())
  developmentId String
  entity        String
  entityId      String
  action        String
  runAt         DateTime
  requestedById String
  status        String    @default("PENDING")
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, runAt])
  @@index([developmentId, entity, entityId])
}

/// Editors request a decision; a publisher approves or rejects it explicitly.
model PublicationApproval {
  id            String    @id @default(cuid())
  developmentId String
  entity        String
  entityId      String
  action        String
  note          String?
  status        String    @default("PENDING")
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([developmentId, status, createdAt])
}

enum SyncStatus {
  PENDING
  DELIVERED
  FAILED
}

// ─────────────────────────── Ops ────────────────────────────────────

model MediaJob {
  id         String    @id @default(cuid())
  kind       String // "variants" | "depth" | "tile" | "hls" | "frames"
  refType    String
  refId      String
  status     JobStatus @default(QUEUED)
  attempts   Int       @default(0)
  error      String?   @db.Text
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model AdminUser {
  id                 String      @id @default(cuid())
  email              String      @unique
  passwordHash       String
  name               String
  /// The one role that decides what this person may do (see Role).
  roleId             String
  role               Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Kept equal to `status` ∈ {ACTIVE, INVITED}: the sign-in gate every guard reads.
  active             Boolean     @default(true)
  status             UserStatus  @default(ACTIVE)
  phone              String?
  department         String?
  jobTitle           String?
  /// Who they report to. Defines a TEAM data scope: a manager and their direct reports.
  managerId          String?
  manager            AdminUser?  @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports            AdminUser[] @relation("ReportsTo")
  /// Last authenticated request (written at most every few minutes).
  lastActiveAt       DateTime?
  deactivatedAt      DateTime?
  totpSecret         String?
  // §5.9 — issued once at enrolment, stored hashed, single use.
  totpEnrolledAt     DateTime?
  recoveryCodeHashes String[]    @default([])
  /// Bumped by a password change or "sign out everywhere": every session issued
  /// before the new value stops verifying, without a session store.
  tokenVersion       Int         @default(0)
  // §5.9 — login throttle state, per account (the per-IP limit is in the gateway).
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  auditLogs          AdminAuditLog[]
  buyers             Buyer[]                  @relation("BuyerAgent")
  enquiries          Enquiry[]                @relation("EnquiryAgent")
  leadNotes          LeadNote[]               @relation("LeadNoteAuthor")
  viewings           Viewing[]                @relation("ViewingAgent")
  reservations       Reservation[]            @relation("ReservationAgent")
  leadsCreated       Enquiry[]                @relation("LeadCreator")
  tasks              LeadTask[]               @relation("TaskAssignee")
  tasksCreated       LeadTask[]               @relation("TaskCreator")
  deals              Deal[]                   @relation("DealAgent")
  dealsCreated       Deal[]                   @relation("DealCreator")
  documents          LeadDocument[]           @relation("DocumentUploader")
  inbox              AdminNotification[]
  savedViews         SavedView[]
  overrides          UserPermissionOverride[] @relation("OverrideUser")
  overridesGranted   UserPermissionOverride[] @relation("OverrideGrantor")
  approvalsRequested ApprovalRequest[]        @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[]        @relation("ApprovalDecider")

  @@index([roleId])
  @@index([status])
  @@index([managerId])
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// A reusable bundle of permissions. System roles are created from
/// DEFAULT_ROLES in @avida/types; after that the business owns their contents.
model Role {
  id          String           @id @default(cuid())
  /// Stable handle for code and seeds: "SALES_AGENT". Custom roles get "CUSTOM_…".
  key         String           @unique
  name        String
  description String?
  /// Created by the platform: can be edited and deactivated, never deleted.
  system      Boolean          @default(false)
  active      Boolean          @default(true)
  position    Int              @default(100)
  /// When the default grants were written. Null on a system role means "write them on next start".
  seededAt    DateTime?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       AdminUser[]
}

/// One permission a role holds, and how far it reaches (its data scope).
/// Action permissions are stored as ALL; an absent row means not granted.
model RolePermission {
  roleId     String
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  scope      PermissionScope @default(ALL)

  @@id([roleId, permission])
}

enum PermissionScope {
  NONE
  OWN
  ASSIGNED
  TEAM
  DEPARTMENT
  ALL
}

/// A per-person exception to their role, shown apart from it. It replaces the
/// role's value for that one permission (NONE revokes), optionally until a date.
model UserPermissionOverride {
  id          String          @id @default(cuid())
  userId      String
  user        AdminUser       @relation("OverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  scope       PermissionScope
  reason      String?
  expiresAt   DateTime?
  grantedById String?
  grantedBy   AdminUser?      @relation("OverrideGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@unique([userId, permission])
}

/// A change someone may not make themselves, waiting for someone who may.
/// Approving replays the stored change as the approver, through the same
/// endpoint and checks as if they had made it directly.
model ApprovalRequest {
  id            String         @id @default(cuid())
  developmentId String
  /// DISCOUNT | PRICE_CHANGE | RESERVATION | DEAL_CLOSE | CANCELLATION
  kind          String
  entity        String
  entityId      String
  /// "update" (a field change) or "action" (a status transition).
  operation     String
  payload       Json
  summary       String
  note          String?
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   AdminUser      @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     AdminUser?     @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote  String?
  decidedAt     DateTime?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([entity, entityId])
  @@index([requestedById])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// §5.9 — every consequential admin action writes one row: who, what, which
// record, and the before/after values that changed.
model AdminAuditLog {
  id        String    @id @default(cuid())
  actorId   String
  actor     AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String // "residence.price", "media.upload", "enquiry.export"
  entity    String? // "residence", "floor", "media"…
  entityId  String?
  target    String? // human handle: "A1", "Floor 2"
  summary   String? // "Price $120,000 → $125,000"
  before    Json?
  after     Json?
  rowCount  Int? // how many records the action touched
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([actorId])
  @@index([action, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────── SEO engine ────────────────────────────

/// Which kind of record a SeoEntity row describes. One engine serves every
/// entity that can become a page, so a new page type needs no new table.
enum SeoEntityType {
  UNIT
  TYPOLOGY
  LOCATION_PAGE
  POST
  AMENITY
  GALLERY
  FLOOR
}

/// §SEO — the search metadata of one record (a residence, a type, a location
/// page, an article). Every field is an override: empty means "derive it from
/// the record", which is what the website does by default.
model SeoEntity {
  id            String        @id @default(cuid())
  developmentId String
  development   Development   @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  entityType    SeoEntityType
  entityId      String

  /// Set only where the entity's own slug is not the URL (kept for redirects).
  slug            String?
  title           String?
  metaDescription String?  @db.Text
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?  @db.Text
  ogImageId       String?
  ogImage         Media?   @relation("SeoEntityImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  /// schema.org type the page emits ("Apartment", "Place", "Article"…).
  schemaType      String?
  keywords        String[]

  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([developmentId, entityType, entityId])
  @@index([developmentId, entityType])
}

/// §SEO — a 301 (or 302) from an old path. Written by hand in the admin, and
/// automatically whenever a slug changes, so a shared link never dies.
model Redirect {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  fromPath      String
  toPath        String
  statusCode    Int         @default(301)
  /// Why it exists — "slug changed", "campaign", written by whoever added it.
  reason        String?
  enabled       Boolean     @default(true)
  hits          Int         @default(0)
  lastHitAt     DateTime?
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([developmentId, fromPath])
  @@index([developmentId, enabled])
}

/// §SEO — a neighbourhood or city landing page ("/locations/kimihurura").
/// Its nearby places come from the landmarks already held by the development,
/// filtered by the categories chosen here, so nothing is duplicated.
model LocationPage {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  slug          String
  name          String
  kicker        String?
  title         String?
  lede          String?     @db.Text
  body          String?     @db.Text
  /// The area this page speaks about, for the Place schema and the map.
  locality      String?
  region        String?
  country       String      @default("RW")
  latitude      Float?
  longitude     Float?
  /// Landmark categories listed on the page; empty lists every visible one.
  categories    String[]
  heroImageId   String?
  heroImage     Media?      @relation("LocationHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  published     Boolean     @default(false)
  sortOrder     Int         @default(0)
  publishedAt   DateTime?
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([developmentId, slug])
  @@index([developmentId, published])
}

/// §SEO — an article under /insights: buying guides, neighbourhood guides and
/// the questions buyers actually ask.
model Post {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  excerpt       String?     @db.Text
  /// Markdown, rendered by the website.
  body          String      @db.Text
  category      String      @default("Guides")
  tags          String[]
  authorName    String?
  readMinutes   Int?
  heroImageId   String?
  heroImage     Media?      @relation("PostHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  published     Boolean     @default(false)
  publishedAt   DateTime?
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([developmentId, slug])
  @@index([developmentId, published, publishedAt])
}
