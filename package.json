{
  "name": "avida-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @avida/db generate",
    "db:migrate": "pnpm --filter @avida/db migrate",
    "db:seed": "pnpm --filter @avida/db seed",
    "db:reset": "pnpm --filter @avida/db reset",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-public-secrets.mjs",
    "verify:schedules": "node scripts/verify-schedules.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.3",
      "@fastify/middie": ">=9.3.4",
      "vitest": ">=3.2.6",
      "vite": ">=7.3.5",
      "deepmerge-ts": ">=8.0.0",
      "picomatch": ">=4.0.4",
      "path-to-regexp": ">=8.4.0",
      "glob": ">=11.1.0",
      "lodash": ">=4.18.1",
      "mysql2": ">=3.24.4",
      "pino": "^9.9.0"
    }
  }
}
