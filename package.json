{
  "name": "avida-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:seq": "node scripts/dev-sequential.mjs",
    "dev:manager": "node scripts/dev-manager.mjs",
    "dev:manager:stable": "node scripts/dev-manager.mjs --no-api-watch",
    "build": "turbo run build",
    "build:api": "node scripts/build-with-api.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @avida/db generate",
    "db:migrate": "pnpm --filter @avida/db migrate",
    "db:seed": "pnpm --filter @avida/db seed",
    "db:reset": "pnpm --filter @avida/db reset",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-public-secrets.mjs",
    "verify:schedules": "node scripts/verify-schedules.mjs",
    "media:import": "pnpm --filter @avida/api media:import",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ioredis": "5.7.0",
    "prettier": "3.6.2",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.3",
      "@fastify/middie": ">=9.3.4",
      "vitest": ">=3.2.6",
      "vite": ">=7.3.5",
      "deepmerge-ts": ">=8.0.0",
      "picomatch": ">=4.0.4",
      "path-to-regexp": ">=8.4.0",
      "glob": ">=11.1.0",
      "lodash": ">=4.18.1",
      "mysql2": ">=3.24.4",
      "pino": "^9.9.0"
    }
  }
}
