# ─── Copy to .env and fill. Every key here is read by at least one app. ───
# CI fails if a key is read by an app but missing here (scripts/check-env.mjs).

# ─── web (apps/web) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/avida-media
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UI_MODE_DEFAULT=multi
NEXT_PUBLIC_LOCALE=en-GB
NEXT_PUBLIC_DEVELOPMENT_SLUG=almasi-residences
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Sales line and inbox shown on the site. A channel left empty is simply not offered.
NEXT_PUBLIC_SALES_PHONE=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_UMAMI_ID=
REVALIDATE_SECRET=dev-revalidate-secret-change-me
# Server-side only. Where the web server calls the API when that differs from
# the public URL (docker-compose.prod.yml sets http://api:3001). Empty = public.
API_INTERNAL_URL=
# Optional build/dev output dir, so a second Next server (preview, e2e) can run
# beside `pnpm dev` without both writing into apps/web/.next. Empty = .next
NEXT_DIST_DIR=

# ─── api (apps/api) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://avida:avida@localhost:5432/avida?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002

# Any S3-compatible object store (MinIO locally and in production).
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=avida-media
S3_ORIGINALS_BUCKET=avida-originals
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/avida-media
# Admin media library (D-33). `local` stores uploads on disk under
# MEDIA_STORAGE_DIR (default: <repo>/storage/media) and serves them from
# /api/v1/files; `s3` writes to the bucket above and links S3_PUBLIC_URL.
STORAGE_DRIVER=local
MEDIA_STORAGE_DIR=

RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAILS=
ADMIN_SESSION_SECRET=dev-session-secret-at-least-32-chars-long
# Seed-only. The seeded admin accounts are for local development; §5.9 requires
# TOTP enrolment before an account can sign in with NODE_ENV=production.
SEED_ADMIN_PASSWORD=phase-one-local-only
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Roadmap phase 2 — signs the admin's one-hour preview links (falls back to ADMIN_SESSION_SECRET).
PREVIEW_SECRET=
# The public website origin the admin opens previews on.
WEB_PUBLIC_URL=http://localhost:3000
SENTRY_DSN=
WHATSAPP_NUMBER=
ENQUIRY_FROM_EMAIL=

# --- concierge (apps/api, Phase 5) ---
# Optional. Without it the concierge answers deterministically, which is the
# product; the model only ever writes prose about a result it is given.
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-sonnet-5

# ─── worker (apps/worker) ─────────────────────────────────────────────────
FFMPEG_PATH=
FFPROBE_PATH=
DEPTH_MODEL_PATH=
SKYBOX_API_KEY=

# ─── admin (apps/admin) ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
# Where the admin links "View on website". Defaults to http://localhost:3000.
VITE_SITE_URL=

# ─── scripts ──────────────────────────────────────────────────────────────
# Overrides for scripts/verify-schedules.mjs; both default to the values above.
API_URL=http://localhost:3001
DEVELOPMENT_SLUG=almasi-residences
