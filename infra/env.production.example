# ─── Single-VPS production settings ──────────────────────────────────────
# scripts/vps/init-env.sh copies this to .env.production at the repo root and
# replaces every __GENERATE__ with a fresh random secret. Never commit the copy.
#
# Sites served (each needs a DNS A record pointing at the VPS):
#   DOMAIN, www.DOMAIN, api.DOMAIN, admin.DOMAIN, storage.DOMAIN

DOMAIN=example.com
# https in production (Let's Encrypt, automatic). http only for a local dry run.
SCHEME=https
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=__GENERATE__
MINIO_ROOT_USER=avida
MINIO_ROOT_PASSWORD=__GENERATE__
ADMIN_SESSION_SECRET=__GENERATE__
REVALIDATE_SECRET=__GENERATE__

# The API is published on the VPS loopback only (the web build reads it).
API_HOST_PORT=3001

# ─── Admin sign-in ───────────────────────────────────────────────────────
# "Continue with Google": an OAuth client (Web application) from
# console.cloud.google.com with the authorised redirect URI
#   https://admin.DOMAIN/api/v1/admin/auth/google/callback
# Leave empty to offer email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true = every password sign-in needs an authenticator code (no enrolment, no entry).
ADMIN_REQUIRE_TOTP=false

# ─── Optional integrations: leave empty to disable ───────────────────────
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAILS=
ENQUIRY_FROM_EMAIL=
WHATSAPP_NUMBER=
# Google Routes API (Compute Route Matrix): road distances and times for nearby places.
GOOGLE_MAPS_API_KEY=
UMAMI_ID=
MAP_STYLE_URL=
SENTRY_DSN=
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-sonnet-5
SKYBOX_API_KEY=
